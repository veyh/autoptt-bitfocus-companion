{
	"private": true,
	"name": "autoptt",
	"version": "1.1.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/veyh/autoptt-bitfocus-companion.git"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@bufbuild/protobuf": "catalog:",
		"@companion-module/base": "catalog:",
		"varint": "catalog:"
	},
	"devDependencies": {
		"@companion-module/tools": "catalog:",
		"@types/node": "^22.18.13",
		"@types/varint": "catalog:",
		"eslint": "^9.39.0",
		"husky": "catalog:",
		"lint-staged": "catalog:",
		"prettier": "catalog:",
		"rimraf": "^6.1.0",
		"typescript": "~5.8.3",
		"typescript-eslint": "catalog:"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.10.3"
}
